## ==========================================
## ASP.NET Web Forms Specific Ignored Files
## ==========================================

# Ignore compiled binaries generated during local builds
[Bb]in/
[Oo]bj/

# Ignore local IIS Express configuration files and caches
.vs/
.vscode/
_ReSharper*/
[Tt]est[Rr]esults/

# Ignore local publishing profiles (prevents leaking server passwords/URLs)
*.pubxml
*.pubxml.user

# Ignore dynamic compilation files generated by the ASP.NET runtime
App_Data/RadControls/
App_Data/TEMP/
App_Data/*.ldf
App_Data/*.mdf

# Ignore local user-specific project files (saves window layouts and active configurations)
*.csproj.user
*.user
*.suo
*.sln.docstates

## ==========================================
## Packages and Dependencies
## ==========================================

# Ignore the legacy NuGet packages folder (let Visual Studio restore them automatically)
packages/
!packages/repositories.config

# Ignore node_modules if you use frontend build tools
node_modules/

## ==========================================
## Operating System / Generic Files
## ==========================================

# Windows
Thumbs.db
Ehthumbs.db
Desktop.ini

# Mac
.DS_Store
.AppleDouble
.LSOverride